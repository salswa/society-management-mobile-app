# Optional override for the backend base URL (must end with /api).
# Leave unset to auto-use localhost in dev:
#   - iOS simulator: http://localhost:4000/api
#   - Android emulator: http://10.0.2.2:4000/api
#   - Physical device: set this to your PC's LAN IP, e.g. http://192.168.1.5:4000/api
# In production builds, set this to your deployed URL, e.g. https://portl-backend.onrender.com/api
# EXPO_PUBLIC_API_URL=
