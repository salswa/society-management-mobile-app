# Supabase project URL, e.g. https://xxxxxxxx.supabase.co
SUPABASE_URL=

# New-style API keys (replace legacy anon / service_role).
# Publishable key (sb_publishable_...) — safe for public contexts; used to verify user JWTs.
SUPABASE_PUBLISHABLE_KEY=

# Secret key (sb_secret_...) — elevated access; server-only. Never expose to the app.
SUPABASE_SECRET_KEY=

# Used only by `npm run gen:types` (supabase CLI). Not needed at runtime.
SUPABASE_PROJECT_ID=

# HTTP server port
PORT=4000

# Bootstrap admin created by `npm run seed`
SEED_SOCIETY_NAME=Green Meadows
SEED_ADMIN_EMAIL=admin@portl.app
SEED_ADMIN_PASSWORD=admin123
SEED_ADMIN_NAME=Society Admin
